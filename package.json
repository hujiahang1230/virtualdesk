{
  "name": "virtualdesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "把平板/手机变成电脑第二块显示屏 —— 技术科普 + WebRTC 屏幕串流原型",
  "scripts": {
    "dev": "next dev",
    "build": "next typegen && next build",
    "typegen": "next typegen",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "postinstall": "node scripts/fix-esbuild.mjs",
    "db:push": "node scripts/db-setup.mjs push",
    "db:status": "node scripts/db-setup.mjs status",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:setup": "node scripts/db-setup.mjs ensure",
    "postgres:start": "node scripts/dev-postgres.mjs start",
    "postgres:stop": "node scripts/dev-postgres.mjs stop",
    "verify:api": "node scripts/verify-api.mjs",
    "verify:pages": "node scripts/verify-pages.mjs",
    "app:web": "node shell/scripts/build-web.mjs",
    "app:pack": "node shell/scripts/pack.mjs",
    "app:build": "node shell/scripts/pack.mjs",
    "app:run": "shell/dist/第二块屏.exe",
    "app:serve": "shell/dist/第二块屏.exe --serve",
    "app:diagnose": "shell/dist/第二块屏.exe --diagnose"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "next": "15.5.27",
    "postgres": "3.4.9",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "15.5.27",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "25.9.9",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
